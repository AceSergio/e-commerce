// Prisma Schema for Universal E-Commerce Starter Kit

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  address   String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  orders    Order[]

  @@map("users")
}

model AuthCode {
  id         String   @id @default(uuid())
  email      String
  code       String
  expiresAt  DateTime @map("expires_at")
  isRegister Boolean  @default(false) @map("is_register")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("auth_codes")
}

model Category {
  id          String    @id
  name        String
  description String?
  products    Product[]

  @@map("categories")
}

model Product {
  id            String      @id
  categoryId    String      @map("category_id")
  category      Category    @relation(fields: [categoryId], references: [id])
  name          String
  subtitle      String?
  description   String?
  price         Float
  unit          String      // ex: "Flacon 100ml", "Coffret 5 pièces", "1 kg"
  image         String
  badge         String?     // ex: "Best-seller", "Édition Limitée", "Bio"
  origin        String?     // ex: "France", "Madagascar", "Japon"
  spec1Label    String?     // ex: "Concentration", "Contenance", "Teneur"
  spec1Value    String?     // ex: "100% Pure", "50 ml", "> 2.0%"
  spec2Label    String?     // ex: "Conservation", "Récolte", "Usage"
  spec2Value    String?     // ex: "24 mois", "2026", "Visage & Corps"
  isPopular     Boolean     @default(false) @map("is_popular")
  stockQuantity Int         @default(100) @map("stock_quantity")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  orderItems    OrderItem[]

  @@map("products")
}

model Order {
  id              String      @id @default(uuid())
  orderId         String      @unique @map("order_id")
  paymentIntentId String?     @map("payment_intent_id")
  status          String      @default("pending") // pending | paid | shipped
  customerName    String?     @map("customer_name")
  customerEmail   String      @map("customer_email")
  customerAddress String?     @map("customer_address")
  totalAmount     String      @map("total_amount")
  currency        String      @default("EUR")
  trackingNumber  String?     @map("tracking_number")
  trackingUrl     String?     @map("tracking_url")
  paidAt          DateTime?   @map("paid_at")
  shippedAt       DateTime?   @map("shipped_at")
  deletedAt       DateTime?   @map("deleted_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  userId          String?     @map("user_id")
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  items           OrderItem[]

  @@index([customerEmail])
  @@index([paymentIntentId])
  @@index([deletedAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?  @map("product_id")
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name        String
  unitPrice   Float    @map("unit_price")
  quantity    Int

  @@map("order_items")
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}
