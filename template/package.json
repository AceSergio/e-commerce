{
  "name": "ecommerce-starter-kit",
  "version": "1.0.0",
  "description": "Universal E-Commerce Starter Kit & Admin Platform (Express + React 19 + Prisma SQLite + Stripe)",
  "main": "server.js",
  "scripts": {
    "init:shop": "node scripts/setup-shop.js",
    "start": "node scripts/start-all.js",
    "start:all": "node scripts/start-all.js",
    "start:public": "node server.js",
    "start:admin": "node archives/legacy_admin/server.js",
    "dev": "node scripts/start-all.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "test": "node --test tests/app.test.js"
  },
  "keywords": [
    "ecommerce",
    "starter-kit",
    "boilerplate",
    "express",
    "prisma",
    "stripe",
    "react",
    "vite"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "body-parser": "^2.3.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3"
  }
}
